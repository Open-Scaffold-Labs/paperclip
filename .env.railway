# ═══════════════════════════════════════════════════════════════
# OpenScaffold Paperclip — Railway Environment Variables
# Copy these into Railway's Variables tab for the Paperclip service.
# Values marked <FILL> must be set manually.
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=3100
HOST=0.0.0.0
NODE_ENV=production
SERVE_UI=true

# ── Database (auto-set if you add Railway Postgres addon) ────
# DATABASE_URL=<auto-populated by Railway Postgres plugin>

# ── Deployment mode ──────────────────────────────────────────
# "authenticated" + "private" = login required, Tailscale/VPN access
# "authenticated" + "public"  = login required, internet-facing
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# ── Public URL (Railway assigns this automatically) ──────────
# PAPERCLIP_PUBLIC_URL=https://<your-app>.up.railway.app

# ── Auth secret (generate with: openssl rand -base64 32) ─────
BETTER_AUTH_SECRET=<FILL>

# ── Paperclip home (container path, don't change) ───────────
PAPERCLIP_HOME=/paperclip
PAPERCLIP_INSTANCE_ID=openscaffold

# ── LLM API Keys (for agent adapters) ───────────────────────
ANTHROPIC_API_KEY=<FILL>
# OPENAI_API_KEY=<FILL>       # Only if using Codex adapter
# GOOGLE_API_KEY=<FILL>       # Only if using Gemini adapter (Dale)

# ── Memory System Integration ────────────────────────────────
PINECONE_API_KEY=<FILL>
# Wiki vault is git-cloned into the container at build time
# Agents reference it via AGENTS.md instructions
